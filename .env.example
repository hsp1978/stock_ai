# ═══════════════════════════════════════════════════════════════════
# Stock AI Analysis System - 통합 환경 설정 (single source of truth)
# ═══════════════════════════════════════════════════════════════════
# 사용법: cp .env.example .env
# 이 파일 하나로 stock_analyzer/ 와 chart_agent_service/ 양쪽이 동작합니다.

# ─── 필수: LLM 설정 ───────────────────────────────────────────────
# Ollama (로컬 LLM - 필수). 설치: ollama pull qwen3:14b-q4_K_M (~9GB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b-q4_K_M

# ─── 선택: 외부 LLM API (없으면 Ollama만 사용) ────────────────────
# OpenAI - 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini - 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=
# gemini-2.0-flash 는 2026-09-15 확인 시 404 로 폐기됐다
# ("This model is no longer available ... use models/gemini-3.6-flash").
#
# 무료 등급 쿼터는 **모델당 하루 20회**다
# (429 본문: GenerateRequestsPerDayPerProjectPerModel-FreeTier = 20).
# Gemini 에이전트 4개 × 워치리스트 7종목 = 배치 1회에 28회 → 한 모델로는 매일
# 20회에서 끊기고 나머지가 Ollama 로 폴백된다. 스캔·뉴스 감성까지 합치면 배치
# 시작 전에 소진돼 있을 수도 있다.
#
# FALLBACK 은 쿼터가 따로 계산되는 **다른 모델**이다 (20 + 20 = 40 > 28).
# 라우터가 429 를 받으면 외부 후보 루프에서 이쪽으로 넘어간다.
# 가용 모델 확인: GET https://generativelanguage.googleapis.com/v1beta/models?key=...
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ─── 선택: 외부 데이터 API ────────────────────────────────────────
# FRED (거시 경제 - 무료) - 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# FMP (추가 재무 데이터 - 선택)
FMP_API_KEY=

# DART (한국 공시 - 무료) - 발급: https://opendart.fss.or.kr/
DART_API_KEY=

# KRX 정보데이터시스템 로그인 (한국 종목 펀더멘털 PER/PBR/EPS/BPS - 무료)
# 가입: https://data.krx.co.kr/ — 2025-05부터 재무 조회에 로그인 필수 (pykrx가 사용)
# 미설정 시 Value Investor는 yfinance 단독으로 폴백
KRX_ID=
KRX_PW=

# ─── 선택: 텔레그램 알림 ──────────────────────────────────────────
# 봇 생성: @BotFather → /newbot → 토큰 복사
#
# CHAT_ID 확인: 봇에게 아무 메시지나 보낸 뒤(먼저 말을 걸지 않으면 봇이 발송할 수
# 없다 — 'chat not found'), 아래로 조회한다.
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#     | jq '.result[].message.chat | {id, type, username}'
# 주의: 웹훅이 설정돼 있으면 getUpdates가 항상 비므로 getWebhookInfo를 먼저 확인.
#       업데이트는 24시간만 보관되고 소비하면 사라진다(안 보이면 다시 메시지 전송).
# 값이 틀리면 /health의 alert_delivery가 failing + 사유를 노출한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── 서비스 설정 ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8100
AGENT_API_HOST=localhost
AGENT_API_PORT=8100

# ─── 스케줄러 ─────────────────────────────────────────────────────
# ⚠ 모든 크론 시각은 **UTC** 다. 컨테이너에 TZ 를 주지 않으므로 APScheduler 가
# Etc/UTC 로 돈다. KST 로 읽으면 9시간 어긋난다.
#
# 2026-09-15 확인: 이 주석이 "서버 로컬 시간 기준"이라고 적혀 있어서
# screener_batch(16:30)가 KST 01:30(다음날)에 돌고 있었다 — 9/13 장 마감 표본이
# 9/14 날짜로 적립돼 ticker_day 와 horizon 시작일이 하루씩 밀렸다.
#
# TZ=Asia/Seoul 로 바꾸지 않는 이유: datetime.now() 가 KST naive 를 뱉게 되고
# DB 에 이미 쌓인 UTC aware 타임스탬프와 섞인다. horizon 계산이 조용히 틀어지는
# 쪽이 시각 환산보다 훨씬 위험하다 (CLAUDE.md §5.5).
#
#   값을 정할 때는 KST 의도에서 9를 빼라.   KST 17:30 → UTC 08:30
#
#   UTC 07:30 = KST 16:30   스크리너 (KRX 마감 15:30 이후)
#   UTC 08:30 = KST 17:30   멀티에이전트 배치
#   UTC 14:00 = KST 23:00   신호 사후검증
#   UTC 15:05 = KST 00:05   코퍼레이트 액션
#   UTC 18:30 = KST 03:30   산출물 정리
#   UTC 19:00 = KST 04:00   상태 백업
SCAN_INTERVAL_MINUTES=30

# 일일 멀티에이전트(V2) 배치 — signal_outcomes 표본 자동 축적 (60일 hit-rate 검증용)
# 08:30 UTC = 17:30 KST (KRX 마감 15:30 이후). false 로 비활성 가능.
MULTI_AGENT_BATCH_ENABLED=true
MULTI_AGENT_BATCH_HOUR=8
MULTI_AGENT_BATCH_MINUTE=30

# ─── 스캔 병렬 처리 ────────────────────────────────────────────────
# 동시에 분석할 종목 수. Ollama OLLAMA_NUM_PARALLEL과 같은 값 권장.
# RTX 5070(12GB VRAM) + qwen3:14b(~9GB): 병렬 2 가능 (여유 3GB)
# Mac Studio M1 Max(32GB): 병렬 3 가능
# GPU 메모리 부족 시 1로 설정 (순차 실행)
SCAN_PARALLEL_WORKERS=3

# Ollama 동시 처리 수 (SCAN_PARALLEL_WORKERS와 맞춰야 병렬 효과 발휘)
# ollama serve 실행 전: export OLLAMA_NUM_PARALLEL=3
OLLAMA_NUM_PARALLEL=3

# ─── 관심 종목 (선택, watchlist.txt가 우선) ──────────────────────
WATCHLIST=

# ─── 신호 판정 / 알림 임계값 ──────────────────────────────────────
# composite score = 방향성 도구 평균. 개별 도구 점수는 [-6, +8]이지만 24개를
# 평균하면 분산이 상쇄돼 실측 [-1.00, +2.04]에 머문다
# (p10 -0.19 / p50 +0.41 / p90 +1.14, 26,041 스캔, 2026-06-20~07-30).
# 합계 스케일 잔재인 ±2.0을 쓰면 BUY 40일 1건 / SELL 도달 불가가 된다.
SIGNAL_BUY_THRESHOLD=1.3
SIGNAL_SELL_THRESHOLD=-0.5
# 알림은 신호 판정보다 느슨해야 판정된 신호가 통보 없이 사라지지 않는다.
BUY_THRESHOLD=1.2
SELL_THRESHOLD=-0.4
MIN_CONFIDENCE=5.0

# ─── 신호 사후 평가 큐 ────────────────────────────────────────────
# 매일 14:00 UTC(=23:00 KST) 배치가 도래한 horizon(7/14/30일)을 오래된 것부터 채운다.
# 창(DAYS_BACK)을 벗어난 행은 다시 후보가 되지 않으므로 30일 horizon 도래 후
# 여유를 둔다. LIMIT은 한 런에서 처리할 행 수 — 시세는 티커별 1회만 받으므로
# 수천 건도 수 초면 끝난다. 잔량이 BACKLOG_ALERT를 넘으면 검증 잡 status가
# degraded 로 떨어지고 텔레그램 ops 알림이 나간다.
SIGNAL_EVAL_DAYS_BACK=90
SIGNAL_EVAL_BATCH_LIMIT=2000
SIGNAL_EVAL_BACKLOG_ALERT=500

# ─── 데이터 신선도 점검 범위 ──────────────────────────────────────
# 워치리스트와 보유 포지션은 항상 본다. 과거 1회성 분석 종목은 이 일수 안에
# 분석된 것만 본다 (0 이면 아예 제외). 종전에는 프로세스가 기억하는 모든
# 종목을 봐서, 워치리스트에서 빠진 지 한 달 넘은 15종목이 영구 stale 로 남아
# /ops/data-health 가 늘 'stale' 이었다 — 경보가 항상 켜져 있으면 경보가 아니다.
# 범위 밖 종목은 숨기지 않고 excluded 목록에 사유와 함께 실린다.
DATA_HEALTH_RECENT_ANALYSIS_DAYS=3

# 보유 포지션 시가평가 주기(분). 손절·익절·트레일링·시간청산은 전부 이 잡에서만
# 평가된다 — 주기를 늘리면 청산이 그만큼 늦게 걸린다. 종전에는 스케줄 등록이
# 없어 WebUI '가격 갱신' 버튼을 누를 때만 돌았다 (실측: 144일간 미평가).
POSITION_MARK_INTERVAL_MINUTES=30

# ─── 산출물 보존 ──────────────────────────────────────────────────
# output/ 는 정리 주체가 없어 JSON 70,771개 / 1.58 GB 까지 쌓였다 (2026-09-14).
# 분석 JSON 은 쓰기 전용이다 — json_path 를 다시 여는 코드가 없고 내용은 scan_log
# DB 에 있다. 차트 PNG 는 화면이 읽으므로 **현재 참조 중인 것은 나이와 무관하게**
# 남는다. 삭제는 되돌릴 수 없으니 필요하면 기간을 늘려라 (ENABLED=false 로 중단).
OUTPUT_RETENTION_ENABLED=true
OUTPUT_JSON_RETENTION_DAYS=30
OUTPUT_CHART_RETENTION_DAYS=30
# 18:30 UTC = 03:30 KST
OUTPUT_RETENTION_HOUR=18
OUTPUT_RETENTION_MINUTE=30

# ─── 상태 백업 (SPOF 대비) ────────────────────────────────────────
# testdev 한 대가 죽으면 전부 정지한다. 잃으면 재생성 불가한 것만 담는다:
# scan_log.db(스캔 이력·signal_outcomes·app_state), 페이퍼 상태, 워치리스트,
# 거래 안전장치 DB. 분석 JSON·차트는 재생성 가능하므로 제외한다.
#
# DB 는 WAL 모드라 cp 로 복사하면 복원 시 깨진다 — sqlite backup API 를 쓰고
# 만든 다음 integrity_check 로 검증한다. .env(키 60여 개)는 기본 미포함이다.
#
# 경로는 **리포지토리 밖**으로 둘 것. 같은 디스크라면 SPOF 를 못 벗어나므로
# 주기적으로 다른 노드(예: macstudio)로 복사해야 한다 — docs/RUNBOOK_BACKUP.md
STATE_BACKUP_ENABLED=true
STATE_BACKUP_DIR=/home/ubuntu/stock_auto_backups
STATE_BACKUP_KEEP=7
# 19:00 UTC = 04:00 KST
STATE_BACKUP_HOUR=19
STATE_BACKUP_MINUTE=0

# 오프사이트 복제. **비워두면 백업이 이 노드에만 있다** (SPOF 미해소).
# 코드가 목적지를 정하지 않는다 — 금융 데이터 사본을 어디에 둘지는 운영 판단이다.
#
# testdev 기준 설정값(2026-09-14): /db4 는 sda(1.8T)로, 운영 데이터가 있는
# nvme0n1 과 **다른 물리 디스크**다. NVMe 고장 시 백업이 살아남는다.
#   OFFSITE_BACKUP_DEST=/db4/stock_auto_backups
#
# 다른 형태:
#   OFFSITE_BACKUP_DEST=/mnt/backup/stock_auto                   외장·NFS 마운트
#   OFFSITE_BACKUP_DEST=hsptest@macstudio:~/stock_auto_backups   rsync over SSH
#     → 원격은 컨테이너가 아니라 호스트 scripts/offsite_sync.sh 로 돌린다
#
# **경로를 바꿀 때는 물리 디스크가 다른지 확인할 것.** 같은 디스크 안의 다른
# 경로로 바꾸면 마운트도 복제도 성공하지만 대비는 사라진다:
#   df --output=source /경로   ← 원본과 다른 장치여야 한다
#
# rsync 종료코드 0 은 '전송 끝'이지 '반대편이 온전함'이 아니다 — 복제 후 목적지에서
# sha256 을 다시 계산해 대조하고, 불일치·확인불가면 degraded 로 보고한다.
OFFSITE_BACKUP_DEST=/db4/stock_auto_backups
# 컨테이너 마운트 경로 (compose.yaml). 로컬 목적지를 쓸 때 함께 맞춘다.
OFFSITE_BACKUP_MOUNT=/db4/stock_auto_backups
OFFSITE_BACKUP_TIMEOUT_SEC=900

# ─── 로깅 ─────────────────────────────────────────────────────────
# 2026-09-14 이전에는 로깅 설정 자체가 없었다 — data_collector·llm/router 등이
# 남기던 logger.info 가 전부 버려지고 있었다 (루트 기본 레벨 WARNING).
# LOG_FILE 을 비우면 컨테이너 stdout 만 쓴다 (docker logs). 파일로 남길 때는
# 반드시 회전이 걸린다 — 종전 service.log 는 로테이션 없이 5MB 까지 갔다.
LOG_LEVEL=INFO
LOG_FORMAT=text          # text | json
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ─── 투자 스타일: scalping | swing | longterm ────────────────────
TRADING_STYLE=swing

# ─── 리스크 관리 ──────────────────────────────────────────────────
ACCOUNT_SIZE=100000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20.0
TAKE_PROFIT_RR_RATIO=2.0

# ─── 듀얼 노드 LLM (선택, Mac Studio 원격 추론 시) ─────────────
# Tailscale MagicDNS 호스트네임 권장 (IP 변경에 강함)
# 미설정 시 자동으로 RTX 5070 단독 모드로 폴백
MAC_STUDIO_IP=hsptest-macstudio
MAC_STUDIO_URL=http://hsptest-macstudio:8080

# ─── Agent API 위치 (선택) ─────────────────────────────────────────
# 미설정 시 AGENT_API_HOST:AGENT_API_PORT 로 자동 합성
# 다른 머신에서 chart_agent_service 가 돌면 직접 가리킴 (예: Tailscale 호스트)
# AGENT_API_URL=http://localhost:8100

# ─── Multi-Agent / LLM Provider 설정 ──────────────────────────────
# DEFAULT_LLM_PROVIDER: ollama | gemini | openai (multi_agent.py 기본값)
DEFAULT_LLM_PROVIDER=ollama
# 8개 에이전트 동시 처리 워커 수 (Mac Studio + RTX 5070 양쪽 분산이라 4 권장)
# 2 면 직렬 가까워 180초 타임아웃 위험. 4 = 각 노드 동시 2개씩 진행.
MULTI_AGENT_MAX_WORKERS=4
# 멀티에이전트 전체 타임아웃 (초). 워커가 모자라면 늘려야.
MULTI_AGENT_TIMEOUT=300

# ─── Phase 2: 주문 실행 (기본은 paper) ─────────────────────────
# TRADING_MODE: paper | dry_run | approval | live
TRADING_MODE=paper
# BROKER_NAME: alpaca | toss | kis (LIVE 모드에서만 사용, Phase 2.2+)
BROKER_NAME=
# 승인 후 실제 실행 모드 (APPROVAL 모드에서 승인 시 사용)
APPROVAL_EXEC_MODE=paper
# 일일 주문 한도
DAILY_ORDER_LIMIT_USD=1000
DAILY_ORDER_LIMIT_KRW=1000000
# 단일 주문 한도
SINGLE_ORDER_LIMIT_USD=200
SINGLE_ORDER_LIMIT_KRW=200000
# 승인 TTL (분) - 이 시간 초과 시 자동 만료
APPROVAL_TTL_MINUTES=30
# 장 시간 강제 (true 시 장외 주문 차단)
ENFORCE_MARKET_HOURS=false

# Phase 2 거래비용 (Sprint 1에서 적용됨)
TRADING_COMMISSION_PCT_KR=0.015
TRADING_COMMISSION_PCT_US=0.0
TRADING_SLIPPAGE_PCT=0.05
TRADING_SELL_TAX_PCT_KR=0.18

# 무위험 수익률 (Sharpe ratio 계산용)
ANNUAL_RISK_FREE_RATE=0.0

# ─── Phase 2.2: Alpaca (미국 증권사, 무료) ───────────────────
# 발급: https://alpaca.markets → Paper Trading 계좌 자동 생성
# Paper (테스트): https://paper-api.alpaca.markets
# Live (실제):    https://api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# 데이터 feed: iex (free) | sip (paid)
ALPACA_DATA_FEED=iex

# 실시간 데이터 소스: yfinance(기본) | alpaca | polygon | kis | toss
# 한 번만 선언할 것 — dotenv는 중복 시 뒤를 채택하므로, 두 곳에 두면 파일을 위에서
# 읽은 값과 실효값이 갈린다 (2026-09-10: yfinance/toss 이중 선언으로 실제는 toss).
# 기동 로그의 `[config] 경고 — .env에 중복 선언된 키` 줄로 감지된다.
DATA_SOURCE=yfinance

# ─── 토스증권 Open API (국내+미국, OAuth2) ───────────────────
# 발급: https://corp.tossinvest.com/ko/open-api → developers.tossinvest.com
# 주문 실행: BROKER_NAME=toss + TRADING_MODE=live (자격증명 없으면 dry_run 폴백)
# 국내 시세: DATA_SOURCE=toss (자격증명 없으면 yfinance 폴백)
# accountSeq는 계좌번호로 자동 식별되므로 TOSS_ACCOUNT_NO에는 계좌번호 입력.
# 모의투자 도메인 미정의 → 제공 시 TOSS_BASE_URL 교체.
# TOSS_APP_KEY=
# TOSS_APP_SECRET=
# TOSS_ACCOUNT_NO=
# TOSS_BASE_URL=https://openapi.tossinvest.com
# TOSS_PAPER=true

# Phase 2.3+ (계획)
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# Phase 2.4 실시간 데이터 (선택)
# POLYGON_API_KEY=

# ─── Step 10: 백테스트 무위험 수익률 / 거래세 ────────────────────────────
# 한국 KOFR 기준 연율 (%)
ANNUAL_RISK_FREE_RATE_KR=3.5
# 미국 3M T-Bill 기준 연율 (%)
ANNUAL_RISK_FREE_RATE_US=4.5
# KRX 거래세 (2026년 기준 0.20%)
KRX_TRADING_TAX_PCT=0.20

# ─── OHLCV 캐시 TTL (Step 3) ─────────────────────────────────────────
# 일봉 캐시 유효 시간 (시간)
OHLCV_TTL_EOD_HOURS=24.0
# 분봉 캐시 유효 시간 (분)
OHLCV_TTL_INTRADAY_MINUTES=5
# 소스별 최대 재시도 횟수
OHLCV_RETRY_COUNT=3

# ─── GlobalKillSwitch 임계값 (Step 1) ─────────────────────────────────
# 일일 손실 알림 임계값 (%)
DAILY_LOSS_LIMIT_ALERT_PCT=2.0
# 일일 손실 강제 정지 임계값 (%)
DAILY_LOSS_LIMIT_HARD_PCT=3.0
# 주간 드로우다운 강제 정지 임계값 (%)
WEEKLY_DRAWDOWN_LIMIT_PCT=5.0
# 고점 대비 드로우다운 강제 정지 임계값 (%)
TRAILING_PEAK_DD_PCT=10.0
# 연속 손실 횟수 강제 정지 임계값
CONSECUTIVE_LOSS_COUNT=5
# VIX 절대 임계값 (이상 시 정지)
VIX_CAP=30.0
# VIX 단기 스파이크 임계값 (%)
VIX_SPIKE_PCT=20.0
# 데이터 최대 허용 경과 시간 (시간)
DATA_STALENESS_HALT_HOURS=6.0
# 정지 후 재개까지 대기 시간 (시간)
COOL_DOWN_HOURS=24

# Mac Studio 를 '가용'으로 볼 조건. 도달성(/api/tags 200)만으로는 부족하다 —
# 2026-09-09~14 실제 사례: CPU 포화 중에 Ollama 가 기동하면서 GPU 탐지가 타임아웃돼
# (`offloaded 0/65 layers to GPU`) 5일간 CPU 로만 돌았다. 32B 모델 0.5 tok/s
# (GPU 복구 후 9.4 tok/s). 그동안 is_mac_studio_available() 은 계속 True 였고
# 8개 중 4개 에이전트가 그 노드로 갔다.
# /api/ps 의 size_vram 비율이 MIN_GPU_FRACTION 미만이면 가용에서 뺀다.
MAC_STUDIO_REQUIRE_GPU=true
MAC_STUDIO_MIN_GPU_FRACTION=0.5
